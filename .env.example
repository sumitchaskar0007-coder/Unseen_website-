# WhatsApp Business / personal number (digits only, include country code, no + or spaces)
# Example for India: 919876543210
VITE_WHATSAPP_NUMBER=
VITE_API_URL=/api

# Server-only values. Never prefix secrets with VITE_ because Vite exposes them to the browser.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/?appName=<app-name>
MONGODB_DB=unseen_studios
PORT=5001
CLIENT_ORIGIN=http://localhost:5173
ADMIN_EMAIL=<admin-email-address>
ADMIN_PASSWORD=<choose-a-strong-admin-password>
ADMIN_TOKEN_SECRET=<generate-a-long-random-secret>
